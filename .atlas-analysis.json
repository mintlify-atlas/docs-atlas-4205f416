  "keyFeatures": [
    "Role-based access control with Administrator and Operator roles",
    "Multi-company parking lot management with cell-level space tracking",
    "Real-time parking cell state management with sensor integration",
    "Reservation lifecycle management (create, finalize, query)",
    "Payment processing with multiple methods (cash, card, transfer)",
    "Electronic invoicing and billing client management",
    "Reporting and analytics per parking lot",
    "JWT-based authentication with NestJS backend",
    "Angular Material UI with responsive dashboards",
    "Oracle Database integration via TypeORM"
  ],
  "publicApiSurface": [
    "POST /api/auth/register",
    "POST /api/auth/login",
    "POST /api/parking-lots",
    "GET /api/parking-lots/empresa/:idEmpresa",
